{
  "name": "virgil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Virgil — a Latin learning project. From Ørberg's Familia Romana to the works of Virgil.",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build && node scripts/postbuild.mjs",
    "build:pages": "NODE_OPTIONS=--max-old-space-size=8192 VITE_BASE=/ vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "icons": "python3 scripts/generate-icons.py",
    "keywords": "node scripts/build-chapter-keywords.mjs",
    "meta": "node scripts/build-books-meta.mjs",
    "vocab": "node scripts/build-printed-vocabulary.mjs",
    "data": "npm run meta && npm run keywords && npm run path && npm run vocab",
    "validate:books": "node scripts/validate-books.mjs",
    "validate:dictionary": "node scripts/validate-dictionary.mjs",
    "validate:keywords": "node scripts/validate-keywords.mjs",
    "validate:all": "npm run validate:books && npm run validate:dictionary && npm run validate:keywords",
    "macra:review": "node scripts/report-macra.mjs",
    "path": "node scripts/build-learning-path.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "whitakers-words": "^0.1.2",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
